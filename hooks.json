{
  "ag-kit-safety-gate": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "run_command",
        "hooks": [
          {
            "command": "node ./hooks/validate-tool-call.mjs",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "ag-kit-circuit-breaker": {
    "enabled": true,
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "command": "node ./hooks/circuit-breaker.mjs",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
